# Normalize line endings; mark binary assets explicitly.
* text=auto

# Source, data and docs: LF in the repository.
*.html    text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.py      text eol=lf
*.sh      text eol=lf
*.ps1     text eol=lf

# Extensionless text files.
LICENSE        text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf
.gitignore     text eol=lf

# Images and archives: never transform.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.zip     binary
*.pdf     binary

# Keep GitHub-generated files out of diffs.
.github/** linguist-documentation
